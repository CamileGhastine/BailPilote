<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
    
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {{ include('shared/header.html.twig') }}
        {{ include('shared/nav.html.twig') }}
        {% block body %}
            <main>
                {% block main %}Main{% endblock %}
            </main>
            <aside>
                {% block aside %}Aside{% endblock %}
            </aside>
        {% endblock %}
        {{ include('shared/footer.html.twig') }}
    </body>
</html>
