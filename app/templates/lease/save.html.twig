{% extends "base.html.twig" %}

{% block title %}{{ isEdit ? 'Modifier' : 'Créer' }} un bail{% endblock %}

{% block body %}
  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8">

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="card border-primary shadow-sm mb-4">
          <div class="card-header bg-primary text-white fw-bold text-center">
            {{ isEdit ? 'Modifier' : 'Créer' }} un bail — {{ property.address.street }}, {{ property.address.city }}
          </div>
          <div class="card-body bg-primary bg-opacity-10">

            <div class="row g-3">

              <div class="col-12 col-md-6">
                {{ form_label(form.type) }}
                {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.type) }}
              </div>

              <div class="col-12 col-md-6">
                {{ form_label(form.leasedAt) }}
                {{ form_widget(form.leasedAt, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.leasedAt) }}
              </div>

              <div class="col-12 col-md-6">
                {{ form_label(form.duration) }}
                {{ form_widget(form.duration, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.duration) }}
              </div>

              <div class="col-12 col-md-6">
                {{ form_label(form.dateOfPayment) }}
                {{ form_widget(form.dateOfPayment, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.dateOfPayment) }}
              </div>

              <div class="col-12 col-md-4">
                {{ form_label(form.rentingAmount) }}
                {{ form_widget(form.rentingAmount, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.rentingAmount) }}
              </div>

              <div class="col-12 col-md-4">
                {{ form_label(form.chargesAmount) }}
                {{ form_widget(form.chargesAmount, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.chargesAmount) }}
              </div>

              <div class="col-12 col-md-4">
                {{ form_label(form.securityDeposit) }}
                {{ form_widget(form.securityDeposit, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.securityDeposit) }}
              </div>

              <div class="col-12">
                {{ form_label(form.irlSelection) }}
                {{ form_widget(form.irlSelection, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.irlSelection) }}
              </div>

            </div>

          </div>
        </div>

        <div class="d-flex justify-content-between mt-2">
          <a href="{{ path('app_owner_show', {'id': property.id}) }}"
            class="btn btn-outline-secondary btn-sm">Annuler</a>
          <button type="submit" class="btn btn-primary btn-sm">
            {{ isEdit ? 'Modifier' : 'Créer' }} le bail
          </button>
        </div>

        {{ form_widget(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}

      </div>
    </div>
  </div>
{% endblock %}
