{% extends 'base.html.twig' %}
{% block title %}Espace bailleur{% endblock %}

{% block body %}
<div class="row my-4">

    {# Colonne principale #}
    <div class="col-12 col-lg-9">

        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-around">
            <a class="btn btn-primary btn-lg text-decoration-none rounded-2 order-2 order-sm-1" href="">Mon compte</a>
            <h1 class="text-center order-1 order-sm-2">Mon espace bailleur</h1>
            <div class="d-flex gap-2 align-items-center justify-content-center bg-primary bg-opacity-10 px-2 rounded order-3">
                <span class="fs-6">Ajouter un bien</span>
                <a class="text-decoration-none fs-4 bg-primary bg-opacity-10 rounded-4" href="">➕</a>
            </div>
        </div>

        {# Navigation sm/md — barre horizontale sous le header, au-dessus des biens #}
        <div class="d-none d-sm-flex d-lg-none flex-wrap gap-2 gap-md-4 mt-3 justify-content-center flex-nowrap">
            <div class="d-flex justify-content-around border border-success rounded-1 bg-primary bg-opacity-10 p-2">
                <a href="" class="btn position-relative text-decoration-none">
                    ✉️
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">9</span>
                </a>
            </div>
            <div class="d-flex justify-content-around border border-warning rounded-1 bg-primary bg-opacity-10 p-2">
                <a href="" class="btn position-relative text-decoration-none">
                    🔔
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">8</span>
                </a>
            </div>
            <div class="d-flex justify-content-around border border-info rounded-1 bg-primary bg-opacity-10 p-2">
                <a href="" class="btn position-relative text-decoration-none">
                    📁
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">13</span>
                </a>
            </div>
            <div class="bg-primary bg-opacity-10 border border-info rounded-1 px-3 py-2">
                <p class="my-auto">Mon compte</p>
            </div>
            <div class="d-flex justify-content-center border border-info rounded-1 gap-3 bg-primary bg-opacity-10 p-2">
                <p class="my-auto">Ma compta générale</p>
                <a class="text-decoration-none fs-6 bg-primary bg-opacity-10 rounded-5 align-self-center" href="">➕</a>
            </div>
        </div>

        {# Navigation mobile uniquement (xs) — collapsible navbar #}
        <nav class="navbar bg-primary rounded-2 mt-3 d-sm-none" data-bs-theme="dark">
            <div class="container-fluid">
                <span class="navbar-brand fw-bold">Navigation</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#asideMenuMobile" aria-controls="asideMenuMobile" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="asideMenuMobile">
                    <div class="d-flex flex-wrap gap-2 w-100 py-2">
                        <div class="d-flex justify-content-around border border-success rounded-1 bg-primary bg-opacity-10 p-2">
                            <a href="" class="btn position-relative text-decoration-none">
                                ✉️
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">9</span>
                            </a>
                        </div>
                        <div class="d-flex justify-content-around border border-warning rounded-1 bg-primary bg-opacity-10 p-2">
                            <a href="" class="btn position-relative text-decoration-none">
                                🔔
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">8</span>
                            </a>
                        </div>
                        <div class="d-flex justify-content-around border border-info rounded-1 bg-primary bg-opacity-10 p-2">
                            <a href="" class="btn position-relative text-decoration-none">
                                📁
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">13</span>
                            </a>>
                        </div>
                        <div class="bg-primary bg-opacity-10 border border-info rounded-1 px-3 py-2">
                            <p class="my-auto">Mon compte</p>
                        </div>
                        <div class="d-flex justify-content-center border border-info rounded-1 gap-3 bg-primary bg-opacity-10 p-2">
                            <p class="my-auto">Ma compta générale</p>
                            <a class="text-decoration-none fs-6 bg-primary bg-opacity-10 rounded-5 align-self-center" href="">➕</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container mt-4 d-flex flex-wrap gap-4 justify-content-center">
            <div class="row gy-3">
                {% for property in properties %}
                <div class="col-12 col-lg-6 col-xl-4">
                    <div class="card border-primary border rounded-2 overflow-hidden">
                        <div class="card-header bg-primary text-white fw-bold">{{property.title}} </div>
                        <div class="card-body bg-primary bg-opacity-10">
                            <div class="d-flex">
                                <div>
                                    <img src="{{asset('image/logo.png')}}" alt="photo de bien"
                                        style="width: clamp(25%, 35%, 200px);">
                                    <ul class="list-unstyled mt-4">
                                        <li>Type: {{property.type}}</li>
                                        <li>surface: {{property.area}} m²</li>
                                        <li>energie: {{property.ecoNote}}</li>
                                    </ul>
                                </div>
                                <div>
                                    <div class="text-nowrap">
                                        <p class="d-inline position-relative ">
                                            <span class="fs-2">✉️</span>
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary ">3</span>
                                        </p>
                                    </div>
                                    <div class="text-nowrap">
                                        <p class="d-inline position-relative ">
                                            <span class="fs-2">🔔</span>
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary ">0</span>
                                        </p>                                    </div>
                                    <div class="text-nowrap">
                                        <p class="d-inline position-relative ">
                                            <span class="fs-2">📁</span>
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary ">2</span>
                                        </p>                                    </div>
                                    <div class="text-nowrap">
                                        <a class="btn btn-primary py-1 my-2 text-decoration-none rounded-2 mt-4"
                                            href="">Gérer</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>

    {# Sidebar lg+ uniquement — colonne droite #}
    <div class="col-lg-3 d-none d-lg-flex flex-column gap-4 rounded-2 align-self-start py-2 px-2" data-bs-theme="dark">
        <div class="d-flex justify-content-around border border-success rounded-1 bg-primary bg-opacity-10 p-2">
            <a href="" class="btn position-relative text-decoration-none text-start text-dark">
                Messages ✉️
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">9</span>
            </a>
        </div>
        <div class="d-flex justify-content-around border border-warning rounded-1 bg-primary bg-opacity-10 p-2">
            <a href="" class="btn position-relative text-decoration-none text-start text-dark">
                Notifications 🔔
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">8</span>
            </a>
        </div>
        <div class="d-flex justify-content-around border border-info rounded-1 bg-primary bg-opacity-10 p-2">
            <a href="" class="text btn position-relative text-decoration-none text-start text-dark">
                Documents 📁
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">13</span>
            </a>
        </div>
        <div class="bg-primary bg-opacity-10 border border-info rounded-1 px-3 py-2 text-center">
            <p class="my-auto">Mon compte</p>
        </div>
        <div class="d-flex justify-content-center border border-info rounded-1 gap-3 bg-primary bg-opacity-10 p-2 ">
            <p class="my-auto">Ma compta générale</p>
            <a class="text-decoration-none fs-6 bg-primary bg-opacity-10 rounded-5 align-self-center" href="">➕</a>
        </div>
    </div>

</div>

{% endblock %}