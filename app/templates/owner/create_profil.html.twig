{% extends 'base.html.twig' %}

{% block title %}Créer mon profil bailleur{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <h1 class="text-center mb-4">Créer mon profil bailleur</h1>

            {{ form_start(form) }}

                <div class="card mb-4">
                    <div class="card-header fw-bold">Informations personnelles</div>
                    <div class="card-body">
                        <div class="mb-3">
                            {{ form_label(form.firstname) }}
                            {{ form_widget(form.firstname, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.firstname) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.lastname) }}
                            {{ form_widget(form.lastname, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.lastname) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.phone) }}
                            {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': '0612345678'}}) }}
                            {{ form_errors(form.phone) }}
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header fw-bold">
                        Adresse <span class="text-muted fw-normal">(facultatif)</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-4">
                                {{ form_label(form.address.number) }}
                                {{ form_widget(form.address.number, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.address.number) }}
                            </div>
                            <div class="col-8">
                                {{ form_label(form.address.street) }}
                                {{ form_widget(form.address.street, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.address.street) }}
                            </div>
                            <div class="col-4">
                                {{ form_label(form.address.zipCode) }}
                                {{ form_widget(form.address.zipCode, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.address.zipCode) }}
                            </div>
                            <div class="col-8">
                                {{ form_label(form.address.city) }}
                                {{ form_widget(form.address.city, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.address.city) }}
                            </div>
                            <div class="col-12">
                                {{ form_label(form.address.addressInfo) }}
                                {{ form_widget(form.address.addressInfo, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_label(form.address.country) }}
                                {{ form_widget(form.address.country, {'attr': {'class': 'form-control'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-5">Créer mon profil</button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>
{% endblock %}
