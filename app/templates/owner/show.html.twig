
{% extends 'base.html.twig' %}

{% block title %}Gestion du bien{% endblock %}

{% block body %}
    <div class="container my-5">

        <h1 class="text-center mb-5">Nom du bien</h1>

        <div class="row g-5 align-items-start">

            {# Colonne gauche #}
            <div class="col-12 col-lg-4">
                <div class="card border-primary rounded border border-2 shadow-sm">
                    <div class="card-header text-center bg-primary text-white fw-bold">
                        Caractéristiques du bien
                    </div>
                    <div class="card-body bg-primary bg-opacity-10">

                        <div class="position-relative mb-4">

                            <a href="#" class="btn btn-primary btn-sm position-absolute top-0 end-0 m-2 z-1 text-decoration-none">
                                + Image
                            </a>

                            {% if property.images is defined and property.images|length > 0 %}
                                <div id="propertyImagesCarousel" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner rounded border">

                                        {% for image in property.images %}
                                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                                <img src="{{ asset(image.path) }}"
                                                     class="d-block w-100 object-fit-cover"
                                                     style="height: 220px;"
                                                     alt="{{ image.alt|default('Photo du bien') }}">
                                            </div>
                                        {% endfor %}

                                    </div>

                                    <button class="carousel-control-prev"
                                            type="button"
                                            data-bs-target="#propertyImagesCarousel"
                                            data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>

                                    <button class="carousel-control-next"
                                            type="button"
                                            data-bs-target="#propertyImagesCarousel"
                                            data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                </div>
                            {% else %}
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                     style="height: 220px;">
                                    <span class="text-muted">Aucune image</span>
                                </div>
                            {% endif %}

                        </div>
                        <div class="text-center mb-4">
                            <p class="mb-1 fw-bold">
                                {# {{ property.address }} #}
                                Adresse du bien
                            </p>

                            <p class="mb-0">
                                {{ property.address.number }} {{ property.address.street ~ ','}} {{ property.address.zipCode }} {{ property.address.city ~ ' - ' ~ property.address.country}}
                                
                            </p>
                        </div>
                        <hr>
                        <div class="row text-center mb-4">
                            <div class="col-6 mb-3">
                                <span class="fw-bold d-block">Type</span>
                                <span>
                                    {# {{ property.type }} #}
                                    {{property.type}}
                                </span>
                            </div>
                            <div class="col-6 mb-3">
                                <span class="fw-bold d-block">Surface</span>
                                <span>
                                    {# {{ property.surface }} m² #}
                                    {{property.area}} m²
                                </span>
                            </div>
                            <div class="col-6 mb-3">
                                <span class="fw-bold d-block">Conso énergie</span>
                                <span>
                                    {# {{ property.energyGrade }} #}
                                    {{property.ecoNote}}
                                </span>
                            </div>
                            <div class="col-6 mb-3">
                                <span class="fw-bold d-block">GES</span>
                                <span>
                                    {# {{ property.gesGrade }} #}
                                    {{property.gesNote}}
                                </span>
                            </div>
                        </div>
                        <hr>
                        <div class="mb-4">
                            <h6 class="fw-bold text-center mb-3">
                                Description pour l'annonce
                            </h6>

                            <p class="mb-0">
                                {# {{ property.description }} #}
                                {{property.description}}
                            </p>
                        </div>
                        <div class="text-center">
                            <a href="{{ path('app_property_new', {id: property.id})}}" class="btn btn-primary btn-sm">Modifier</a>
                        </div>
                    </div>
                </div>
            </div>

            {# Colonne centrale : bail + locataires #}
            <div class="col-12 col-lg-4">

                {# Bail #}
                <div class="card shadow-sm border-primary mb-4">
                    <div class="card-header text-center bg-primary text-white fw-bold">
                        Bail
                    </div>
                    <div class="card-body bg-primary bg-opacity-10">
                        {% if property.lease %}
                            <p class="mb-2"><strong>Type :</strong> {{ property.lease.type }}</p>
                            <p class="mb-2"><strong>Date de début :</strong> {{ property.lease.leasedAt|date('d/m/Y') }}</p>
                            <p class="mb-2"><strong>Durée :</strong> {{ property.lease.duration }} mois</p>
                            <p class="mb-2"><strong>Loyer HC :</strong> {{ property.lease.rentingAmount|number_format(2, ',', ' ') }} €</p>
                            <p class="mb-2"><strong>Charges :</strong> {{ property.lease.chargesAmount ? property.lease.chargesAmount|number_format(2, ',', ' ') ~ ' €' : '-' }}</p>
                            <p class="mb-2"><strong>Dépôt de garantie :</strong> {{ property.lease.securityDeposit|number_format(2, ',', ' ') }} €</p>
                            <p class="mb-2"><strong>Jour de paiement :</strong> le {{ property.lease.dateOfPayment }}</p>
                            <p class="mb-2"><strong>IRL :</strong> {{ property.lease.irlValue }} ({{ property.lease.irlPeriod|replace({'-Q': '-T'}) }})</p>
                            <div class="text-center mt-3">
                                <a href="{{ path('app_lease_save', {'propertyId': property.id, 'id': property.lease.id}) }}"
                                   class="btn btn-primary btn-sm">Modifier</a>
                            </div>
                        {% else %}
                            <div class="text-center py-3">
                                <p class="text-muted mb-3">Aucun bail rattaché à ce bien.</p>
                                <a href="{{ path('app_lease_save', {'propertyId': property.id}) }}"
                                   class="btn btn-success btn-sm">Créer un bail</a>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>Locataires</span>
                        <a href="{{ path('app_owner_save_tenant', {'propertyId': property.id}) }}"
                           class="btn btn-success btn-sm">+ Ajouter</a>
                    </div>

                    <div class="card-body bg-primary bg-opacity-10">

                        {% if tenants|length > 0 %}

                            <div class="d-flex flex-column gap-3">

                                {% for tenant in tenants %}
                                    <div class="card shadow-sm border-primary">
                                        <div class="card-body">

                                            <p class="mb-2">
                                                <span class="fw-bold">Nom prénom :</span>
                                                {{ tenant.user.firstname ~ ' ' ~ tenant.user.lastname }}
                                            </p>

                                            <p class="mb-2">
                                                <span class="fw-bold">Email :</span>
                                                {{ tenant.user.email }}
                                            </p>

                                            <p class="mb-2">
                                                <span class="fw-bold">Téléphone :</span>
                                                {{ tenant.user.phone }}
                                            </p>

                                            <div class="text-center mt-3">
                                                <a href="{{ path('app_owner_save_tenant', {'propertyId': property.id, 'id': tenant.id}) }}"
                                                   class="btn btn-primary btn-sm">Modifier</a>
                                            </div>

                                        </div>
                                    </div>
                                {% endfor %}

                            </div>

                        {% else %}

                            <div class="text-center py-4">
                                <p class="text-muted">
                                    Aucun locataire n'est encore rattaché à ce bien.
                                </p>
                            </div>

                        {% endif %}

                    </div>
                </div>


            </div>

            {# Colonne droite #}
            <div class="col-12 col-lg-4">
                <div class="d-flex flex-column gap-4">

                    <div class="card border-info shadow-sm">
                        <div class="card-header text-center fw-bold">Messagerie</div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                     style="width: 40px; height: 40px;">L</div>
                                <p class="fw-bold mb-0">Locataire</p>
                            </div>
                            <div class="border rounded bg-light p-3 mb-3" style="height: 250px; overflow-y: auto;"></div>
                            <form method="post" action="#">
                                <div class="input-group">
                                    <input type="text" name="message" class="form-control form-control-sm"
                                           placeholder="Écrire un message...">
                                    <button class="btn btn-primary btn-sm" type="submit">Envoyer</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow-sm border-warning">
                        <div class="card-header text-center fw-bold">Notifications</div>
                        <div class="card-body">
                            <div class="border rounded p-3">
                                <p class="fw-bold mb-1">Rappel de loyer</p>
                                <p class="small text-muted mb-3">Envoyer un rappel au locataire.</p>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-warning btn-sm flex-grow-1">Envoyer</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm">?</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm border-info">
                        <div class="card-header text-center fw-bold">Quittances</div>
                        <div class="card-body">
                            {% if property.lease and years|length > 0 %}
                                <form method="get" action="{{ path('app_owner_show', {id: property.id}) }}" class="mb-3">
                                    <label for="quittanceYear" class="form-label fw-bold small mb-1">Année</label>
                                    <select id="quittanceYear" name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                                        {% for year in years %}
                                            <option value="{{ year }}" {{ year == selectedYear ? 'selected' : '' }}>{{ year }}</option>
                                        {% endfor %}
                                    </select>
                                </form>
                            {% endif %}
                            {% if paymentsSchedule|length > 0 %}
                                <div class="d-flex flex-column gap-2">
                                    {% for entry in paymentsSchedule %}
                                        {% set payment = entry.payment %}
                                        {% set paid = payment and payment.paid %}
                                        <div class="border rounded p-2 d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="fw-bold d-inline {{ paid ? '' : 'd-lg-block'}}">{{ entry.period|month_year_fr }}</span>
                                                <span class="badge {{ paid ? 'bg-success' : 'bg-secondary' }} ms-2">
                                                    {{ paid ? 'Payé' : 'Non payé' }}
                                                </span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                {% if not paid %}
                                                    {% if not canMarkPaid %}
                                                        <button type="button" class="btn btn-outline-success btn-sm" disabled
                                                                title="Disponible à partir du {{ oldestUnpaidDueDate|date('d/m/Y') }}">
                                                            Marquer payé
                                                        </button>
                                                    {% else %}
                                                        <form method="post" action="{{ path('app_owner_payment_mark_paid', {leaseId: property.lease.id}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('mark_paid_' ~ property.lease.id) }}">
                                                            <input type="hidden" name="clicked_period" value="{{ entry.period|date('Y-m') }}">
                                                            <button type="submit" class="btn btn-outline-success btn-sm"
                                                                    title="Marquera le mois de {{ oldestUnpaidPeriod|month_year_fr }} comme payé">
                                                                Marquer payé
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                {% endif %}
                                                <a href="{{ path('app_owner_payment_quittance', {leaseId: property.lease.id, period: entry.period|date('Y-m')}) }}"
                                                   class="btn btn-primary btn-sm">
                                                    {{ paid ? 'Télécharger' : 'Générer' }}
                                                </a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted text-center mb-0">
                                    {% if property.lease %}
                                        Aucune quittance à afficher pour {{ selectedYear }}.
                                    {% else %}
                                        Aucune quittance à afficher pour le moment.
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card shadow-sm border-info">
                        <div class="card-header text-center fw-bold">Ma compta</div>
                        <div class="card-body">
                            <p class="text-muted mb-3">Comptabilité liée à ce bien.</p>
                            <div class="d-flex gap-2">
                                <a href="#" class="btn btn-outline-primary btn-sm flex-grow-1">Voir ma compta</a>
                                <a href="#" class="btn btn-primary btn-sm">+</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
{% endblock %}